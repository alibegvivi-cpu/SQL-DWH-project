/*
===============================================================================
Кумулятивный (накопительный) анализ
===============================================================================
Цель:
    - Расчет нарастающего итога (running totals) или скользящих средних для ключевых метрик.
    - Отслеживание кумулятивной эффективности (динамики показателей) во времени.
    - Полезно для анализа роста или выявления долгосрочных трендов.

Используемые функции SQL:
    - Оконные функции: SUM() OVER(), AVG() OVER()
===============================================================================
*/

-- Расчет общего объема продаж по годам,
-- а также продаж нарастающим итогом и скользящей средней цены во времени
SELECT
    order_date,
    total_sales,
    SUM(total_sales) OVER (ORDER BY order_date) AS running_total_sales,
    AVG(avg_price) OVER (ORDER BY order_date) AS moving_average_price
FROM
(
    SELECT
        DATE_TRUNC('year', order_date) AS order_date,
        SUM(sales_amount) AS total_sales,
        AVG(price) AS avg_price
    FROM gold.fact_sales
    WHERE order_date IS NOT NULL
    GROUP BY DATE_TRUNC('year', order_date)
) t;
