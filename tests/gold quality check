/*
===============================================================================
Проверки качества данных (Quality Checks) — Версия для PostgreSQL
===============================================================================
Назначение скрипта:
    Этот скрипт выполняет проверки качества для контроля целостности, 
    согласованности и точности данных в слое 'gold'. Эти проверки обеспечивают:
    - Уникальность суррогатных ключей в таблицах измерений (dimensions).
    - Ссылочную целостность между таблицами фактов (facts) и измерений.
    - Валидацию связей в модели данных для аналитических целей.

Примечания по использованию:
    - Изучайте и устраняйте любые несоответствия, обнаруженные в ходе проверок.
===============================================================================
*/

-- ====================================================================
-- Проверка таблицы 'gold.dim_customers'
-- ====================================================================
-- Проверка уникальности ключа клиента (Customer Key) в gold.dim_customers
-- Ожидаемый результат: Нет строк
SELECT 
    customer_key,
    COUNT(*) AS duplicate_count
FROM gold.dim_customers
GROUP BY customer_key
HAVING COUNT(*) > 1;

-- ====================================================================
-- Проверка таблицы 'gold.dim_products'
-- ====================================================================
-- Проверка уникальности ключа продукта (Product Key) в gold.dim_products
-- Ожидаемый результат: Нет строк
SELECT 
    product_key,
    COUNT(*) AS duplicate_count
FROM gold.dim_products
GROUP BY product_key
HAVING COUNT(*) > 1;

-- ====================================================================
-- Проверка таблицы 'gold.fact_sales'
-- ====================================================================
-- Проверка целостности связей модели данных между фактами и измерениями
-- Ищет продажи, для которых отсутствуют соответствующие клиенты или продукты
-- Ожидаемый результат: Нет строк
SELECT * 
FROM gold.fact_sales f
LEFT JOIN gold.dim_customers c
  ON c.customer_key = f.customer_key
LEFT JOIN gold.dim_products p
  ON p.product_key = f.product_key
WHERE p.product_key IS NULL 
   OR c.customer_key IS NULL;
