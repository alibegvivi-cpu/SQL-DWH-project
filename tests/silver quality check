/*
===============================================================================
Проверки качества данных (Quality Checks)
===============================================================================
Назначение скрипта:
    Этот скрипт выполняет различные проверки качества для контроля согласованности, 
    точности и стандартизации данных во всем слое 'silver'. Он включает проверки на:
    - Наличие NULL-значений или дубликатов в первичных ключах.
    - Наличие лишних пробелов в строковых полях.
    - Стандартизацию и согласованность данных.
    - Некорректные диапазоны дат и порядок их следования.
    - Согласованность данных между связанными полями.

Примечания по использованию:
    - Запускайте эти проверки после загрузки данных в слой Silver.
    - Изучайте и устраняйте любые несоответствия, обнаруженные в ходе проверок.
===============================================================================
*/

-- ====================================================================
-- Проверка таблицы 'silver.crm_cust_info'
-- ====================================================================
-- Проверка на NULL и дубликаты в Первичном Ключе
-- Ожидаемый результат: Нет строк
SELECT 
    cst_id,
    COUNT(*) 
FROM silver.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL;

-- Проверка на наличие лишних пробелов
-- Ожидаемый результат: Нет строк
SELECT 
    cst_key 
FROM silver.crm_cust_info
WHERE cst_key != TRIM(cst_key);

-- Стандартизация и согласованность данных
SELECT DISTINCT 
    cst_marital_status 
FROM silver.crm_cust_info;

-- ====================================================================
-- Проверка таблицы 'silver.crm_prd_info'
-- ====================================================================
-- Проверка на NULL и дубликаты в Первичном Ключе
-- Ожидаемый результат: Нет строк
SELECT 
    prd_id,
    COUNT(*) 
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS NULL;

-- Проверка на наличие лишних пробелов
-- Ожидаемый результат: Нет строк
SELECT 
    prd_nm 
FROM silver.crm_prd_info
WHERE prd_nm != TRIM(prd_nm);

-- Проверка на NULL или отрицательные значения в Стоимости
-- Ожидаемый результат: Нет строк
SELECT 
    prd_cost 
FROM silver.crm_prd_info
WHERE prd_cost < 0 OR prd_cost IS NULL;

-- Стандартизация и согласованность данных
SELECT DISTINCT 
    prd_line 
FROM silver.crm_prd_info;

-- Проверка на некорректный порядок дат (Дата начала > Дата окончания)
-- Ожидаемый результат: Нет строк
SELECT 
    * 
FROM silver.crm_prd_info
WHERE prd_end_dt < prd_start_dt;

-- ====================================================================
-- Проверка таблицы 'silver.crm_sales_details'
-- ====================================================================
-- Проверка на некорректные даты
-- Ожидаемый результат: Нет некорректных дат
SELECT 
    NULLIF(sls_due_dt, 0) AS sls_due_dt 
FROM bronze.crm_sales_details
WHERE sls_due_dt <= 0 
    OR LEN(sls_due_dt) != 8 
    OR sls_due_dt > 20500101 
    OR sls_due_dt < 19000101;

-- Проверка на некорректный порядок дат (Дата заказа > Даты отгрузки/оплаты)
-- Ожидаемый результат: Нет строк
SELECT 
    * 
FROM silver.crm_sales_details
WHERE sls_order_dt > sls_ship_dt 
   OR sls_order_dt > sls_due_dt;

-- Проверка согласованности данных: Продажи = Количество * Цена
-- Ожидаемый результат: Нет строк
SELECT DISTINCT 
    sls_sales,
    sls_quantity,
    sls_price 
FROM silver.crm_sales_details
WHERE sls_sales != sls_quantity * sls_price
   OR sls_sales IS NULL 
   OR sls_quantity IS NULL 
   OR sls_price IS NULL
   OR sls_sales <= 0 
   OR sls_quantity <= 0 
   OR sls_price <= 0
ORDER BY sls_sales, sls_quantity, sls_price;

-- ====================================================================
-- Проверка таблицы 'silver.erp_cust_az12'
-- ====================================================================
-- Выявление дат вне допустимого диапазона
-- Ожидаемый результат: Даты рождения строго между 1924-01-01 и сегодняшним днем
SELECT DISTINCT 
    bdate 
FROM silver.erp_cust_az12
WHERE bdate < '1924-01-01' 
   OR bdate > GETDATE();

-- Стандартизация и согласованность данных
SELECT DISTINCT 
    gen 
FROM silver.erp_cust_az12;

-- ====================================================================
-- Проверка таблицы 'silver.erp_loc_a101'
-- ====================================================================
-- Стандартизация и согласованность данных
SELECT DISTINCT 
    cntry 
FROM silver.erp_loc_a101
ORDER BY cntry;

-- ====================================================================
-- Проверка таблицы 'silver.erp_px_cat_g1v2'
-- ====================================================================
-- Проверка на наличие лишних пробелов
-- Ожидаемый результат: Нет строк
